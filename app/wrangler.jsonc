// Cloudflare Workers con static assets: «npm run deploy» compila e pubblica app/dist.
// Di solito lo fa la CI quando si unisce la PR di release (.github/workflows/deploy.yml).
// (Cloudflare Pages è confluito in Workers: i comandi «wrangler pages» vengono girati qui.)
// La prima volta serve «npx wrangler login».
{
  "name": "pillole",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist"
  }
}
